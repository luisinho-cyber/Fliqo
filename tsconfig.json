{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/tests/**/*.ts",
    // tests/ na raiz: as guardas que são do repositório inteiro, e não de um app
    // — hoje as do deploy, que olham os três serviços de uma vez.
    "tests/**/*.ts",
    "tests-e2e/**/*.ts"
  ],
  // apps/demo e apps/web têm tsconfig próprio (Next, JSX): ficam fora do
  // typecheck da raiz e rodam em `typecheck:demo` e `typecheck:web`.
  "exclude": ["node_modules", "apps/demo", "apps/web"]
}
