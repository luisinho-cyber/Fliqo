{
  "name": "fliqo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:core": "vitest run packages/core packages/ai",
    "test:db": "vitest run packages/db",
    "db:migrate": "node packages/db/scripts/migrate.mjs && node packages/db/scripts/fila.mjs",
    "whatsapp:rotacionar-chave": "tsx apps/worker/src/rotacionar-chave.ts",
    "typecheck:demo": "npm --prefix apps/demo run typecheck",
    "build:demo": "npm --prefix apps/demo run build",
    "e2e:demo": "npm --prefix apps/demo run e2e",
    "db:papel-app": "node packages/db/scripts/papel-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.13.1",
    "pg-boss": "^12.33.4",
    "pino": "^10.3.1",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "next": "^16.3.5",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8"
  }
}
