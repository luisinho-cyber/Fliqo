# Copie para .env e preencha. O .env não vai para o repositório.
# Nenhum valor de verdade mora aqui — este arquivo é só a lista do que existe.

# ---------------------------------------------------------------------------
# Banco (Supabase)
# ---------------------------------------------------------------------------
# A aplicação conecta como fliqo_app, pelo pooler em modo transação.
# No painel do Supabase: Connect > Transaction pooler.
DATABASE_URL=postgresql://fliqo_app.SEU_PROJETO:SENHA_DO_FLIQO_APP@HOST_DO_POOLER:6543/postgres

# Dono do schema. Só as migrações e os scripts usam. Nunca vai para a API nem
# para o worker: o dono do schema não passa pela RLS.
# No painel do Supabase: Connect > Direct connection (ou Session pooler, se a
# sua rede não tiver IPv6).
DATABASE_ADMIN_URL=postgresql://postgres:SENHA_DO_POSTGRES@HOST_DIRETO:5432/postgres

# Senha do papel da aplicação. Só é usada ao rodar scripts/papel-app.mjs.
FLIQO_APP_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp (Meta)
# ---------------------------------------------------------------------------
# Meta > App > WhatsApp > Configuration: o mesmo segredo que assina o webhook.
WHATSAPP_APP_SECRET=
# Uma frase inventada por você. A Meta devolve ela na verificação do webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta > App > Configurações básicas.
META_APP_ID=
META_APP_SECRET=
# 32 bytes em base64, para cifrar o token de cada clínica:
#   openssl rand -base64 32
WHATSAPP_TOKEN_KEY=
# Token do número da Fliqo, usado pelo worker enquanto não há clínica conectada.
WHATSAPP_TOKEN=

# ---------------------------------------------------------------------------
# Painel
# ---------------------------------------------------------------------------
# Supabase > Project Settings > API > JWT Secret. Serve para VERIFICAR o token
# do painel. O painel não fala com o banco: fala só com a nossa API.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Assistente Fliqo
# ---------------------------------------------------------------------------
# Esta chave existe SÓ como variável no Railway. Não escreva o valor aqui, nem
# no .env local, nem em nenhum arquivo do repositório.
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-haiku-4-5
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Processo
# ---------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
