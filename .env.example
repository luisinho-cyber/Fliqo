# Copie para .env e preencha. O .env não vai para o repositório.
# Nenhum valor de verdade mora aqui — este arquivo é só a lista do que existe.

# ---------------------------------------------------------------------------
# Banco (Supabase)
# ---------------------------------------------------------------------------
# A aplicação conecta como fliqo_app, pelo pooler em modo transação.
# No painel do Supabase: Connect > Transaction pooler.
DATABASE_URL=postgresql://fliqo_app.SEU_PROJETO:SENHA_DO_FLIQO_APP@HOST_DO_POOLER:6543/postgres

# Dono do schema. Só as migrações e os scripts usam. Nunca vai para a API nem
# para o worker: o dono do schema não passa pela RLS.
# No painel do Supabase: Connect > Direct connection (ou Session pooler, se a
# sua rede não tiver IPv6).
DATABASE_ADMIN_URL=postgresql://postgres:SENHA_DO_POSTGRES@HOST_DIRETO:5432/postgres

# Senha do papel da aplicação. Só é usada ao rodar scripts/papel-app.mjs.
FLIQO_APP_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp (Meta)
# ---------------------------------------------------------------------------
# Meta > App > WhatsApp > Configuration: o mesmo segredo que assina o webhook.
WHATSAPP_APP_SECRET=
# Uma frase inventada por você. A Meta devolve ela na verificação do webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta > App > Configurações básicas.
META_APP_ID=
META_APP_SECRET=
# 32 bytes em base64, para cifrar o token de cada clínica:
#   openssl rand -base64 32
# Vai na api E no worker, com o MESMO valor: a api cifra na conexão, o worker
# decifra para enviar. Não existe token de WhatsApp de ambiente — cada clínica
# manda com a credencial dela, ou não manda.
WHATSAPP_TOKEN_KEY=

# ---------------------------------------------------------------------------
# Painel — apps/api
# ---------------------------------------------------------------------------
# Supabase > Project Settings > API > JWT Secret. Serve para VERIFICAR o token
# do painel. O painel não fala com o banco: fala só com a nossa API.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Painel — apps/web (só o serviço do painel usa estas três)
# ---------------------------------------------------------------------------
# Onde a nossa API responde. O navegador nunca chama este endereço: quem chama
# é o servidor do painel, que é quem tem o token.
API_URL=https://api-da-sua-clinica.up.railway.app

# Supabase > Project Settings > API. São usados SÓ para autenticar, no servidor.
# Sem prefixo NEXT_PUBLIC_ de propósito: nada de Supabase vai para o navegador.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Os dois identificadores do Embedded Signup. São públicos — chegam ao navegador
# como prop, porque o SDK da Meta roda lá. O segredo do app NÃO fica aqui: quem
# troca o código por token é apps/api, e só ela tem META_APP_SECRET.
# META_CONFIG_ID: Meta > seu app > WhatsApp > Embedded Signup > a configuração.
META_APP_ID=
META_CONFIG_ID=

# ---------------------------------------------------------------------------
# Assistente Fliqo
# ---------------------------------------------------------------------------
# Esta chave existe SÓ como variável no Railway. Não escreva o valor aqui, nem
# no .env local, nem em nenhum arquivo do repositório.
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-haiku-4-5
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Processo
# ---------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Vigia de operador (0015) — SÓ no serviço worker
# ---------------------------------------------------------------------
# A chave você gera no painel do serviço de e-mail e cola direto no Railway, no
# worker. Vazia aqui de propósito: segredo não tem valor de exemplo.
EMAIL_API_KEY=
# Remetente verificado no serviço.
EMAIL_REMETENTE=avisos@sua-clinica.com.br
# O seu e-mail: é quem recebe o aviso. Vazio porque é pessoal.
OPERADOR_EMAIL=
# Opcionais, com padrão no código:
# EMAIL_API_URL=https://api.resend.com/emails
# OPERADOR_FUSO=America/Sao_Paulo

# Token do /estado do worker — SÓ no serviço worker. Gere no seu terminal com
# `openssl rand -base64 32` e cole direto no Railway. Vazio aqui de propósito;
# ausente, o /estado fica fechado para todos.
ESTADO_TOKEN=
